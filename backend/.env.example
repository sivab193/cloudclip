# ── CloudClip backend ─────────────────────────────────────────────
# Copy to .env (locally and on the VM at ~/cloudclip/backend/.env).
# .env is gitignored and read by docker compose / dotenv.

PORT=3000
NODE_ENV=production

# MongoDB Atlas → Cluster → Connect → Drivers → Node.js connection string.
# Keep the /cloudclip db name. Each server uses only its nearby regional cluster.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cloudclip?retryWrites=true&w=majority

# Docker Compose supplies this internal address to the backend container.
REDIS_URL=redis://redis:6379

# Public API hostname terminated by Caddy on this server.
CADDY_HOST=api-us.cclip.cc

# Optional and recommended for home servers: create a remotely managed
# Cloudflare Tunnel whose public hostname targets http://backend:3000, then
# start Compose with --profile tunnel. Keep this token only on that server.
CLOUDFLARE_TUNNEL_TOKEN=

# Comma-separated browser origins allowed by CORS (native apps bypass this).
# Production web + local dev. No trailing slashes.
ALLOWED_ORIGINS=https://cclip.cc,https://www.cclip.cc,https://us.cclip.cc,http://localhost:8081

# Firebase Admin SDK — from the service-account JSON:
# Firebase console → Project settings → Service accounts → Generate new private key.
# (Generate a FRESH key for the VM; treat the old local one as leaked.)
#   project_id   → FIREBASE_PROJECT_ID
#   client_email → FIREBASE_CLIENT_EMAIL
#   private_key  → FIREBASE_PRIVATE_KEY (keep the quotes and the \n escapes on one line)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Key-Here\n-----END PRIVATE KEY-----\n"
