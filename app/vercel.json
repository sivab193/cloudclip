{
    "buildCommand": "npx expo export",
    "outputDirectory": "dist",
    "devCommand": "npx expo start",
    "cleanUrls": true,
    "framework": null,
    "headers": [
        {
            "source": "/.well-known/apple-app-site-association",
            "headers": [
                { "key": "Content-Type", "value": "application/json" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/:path*",
            "destination": "/"
        }
    ]
}
