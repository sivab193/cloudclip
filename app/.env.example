# ── CloudClip app ─────────────────────────────────────────────────
# Copy to .env for local dev. For the deployed web app, set these same
# variables in Vercel → Project → Settings → Environment Variables.
# For store builds, put them in eas.json env or EAS environment variables.
# EXPO_PUBLIC_* values are compiled into the client bundle — they are
# public by design (Firebase web config is not a secret).

# Backend API origin (no /api suffix — the app appends it).
# Local dev against a local backend: http://localhost:3000
EXPO_PUBLIC_API_URL=https://cc-api.siv19.dev

# Public web app origin, used to build share links.
EXPO_PUBLIC_WEB_URL=https://cc.siv19.dev

# Firebase web config: Firebase console → Project settings → General →
# Your apps → Web app → SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
