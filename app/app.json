{
  "expo": {
    "name": "CloudClip",
    "slug": "cloud-clip-ui",
    "version": "1.1.0",
    "description": "Your clipboard, on every device. End-to-end encrypted clipboard sync with real-time updates and expiring share links.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cloudclip",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "primaryColor": "#0A7EA4",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudclip",
      "associatedDomains": [
        "applinks:cc.siv19.dev"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A7EA4"
      },
      "package": "com.cloudclip",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cc.siv19.dev",
              "pathPrefix": "/shared"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/icon.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#151718"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3e50f1a1-5ef5-466a-a725-5baeb6f37ad6"
      }
    }
  }
}
