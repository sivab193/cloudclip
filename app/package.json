{
  "name": "cloudclip-app",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release.mjs",
    "eas-build-post-install": "npm run typecheck && npm run check:release",
    "build:web": "expo export --platform web && node scripts/fix-html-head.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble|@scure))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@scure/base": "^2.2.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "@types/three": "^0.185.4",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "query-string": {
      "decode-uri-component": "^0.5.0"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
